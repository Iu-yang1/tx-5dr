# Use this HTTP-only bootstrap until Certbot creates the cert paths.
# Install as /etc/nginx/conf.d/tx5dr.conf, then swap to the TLS template.
server {
    listen 80;
    listen [::]:80;
    server_name radio.example.com;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 404; }
}
