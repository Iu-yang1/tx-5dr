[Unit]
Description=TX5DR public FRP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tx5dr-frp
Group=tx5dr-frp
WorkingDirectory=/var/lib/tx5dr-frp
ExecStart=/usr/local/bin/frps -c /etc/tx5dr-frps/frps.toml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tx5dr-frp
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
